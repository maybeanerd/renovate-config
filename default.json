{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",

    ":pinVersions",
    ":rebaseStalePrs",

    "group:linters"
  ],
  "labels": ["dependencies"],
  "dependencyDashboardApproval": true,
  "automergeStrategy": "fast-forward",
  "minimumReleaseAge": "3 days",
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "14 days"
    }
  ]
}
