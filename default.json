{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",

    ":pinVersions",
    ":automergeMinor",
    ":rebaseStalePrs",

    "group:linters"
  ],
  "labels": ["dependencies"],
  "automergeStrategy": "fast-forward",
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchSourceUrlPrefixes": ["https://github.com/discordjs"],
      "groupName": "discord.js"
    },
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "14 days"
    }
  ]
}
